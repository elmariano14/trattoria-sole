# --- Baza danych ---------------------------------------------------------
# Lokalnie: plik SQLite. Na Vercel: adres bazy Turso (libsql://…) + token.
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

# --- Panel /admin ---------------------------------------------------------
# Hasło do panelu oraz sekret do podpisywania ciasteczka sesji (min. 32 znaki).
ADMIN_PASSWORD="zmien-mnie"
ADMIN_SESSION_SECRET="wygeneruj-losowy-ciag-co-najmniej-32-znaki"

# --- Adres strony (SEO, sitemap, kod QR) -----------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Link do autora projektu w stopce (portfolio). Puste = brak linku.
NEXT_PUBLIC_AUTHOR_URL=""
NEXT_PUBLIC_AUTHOR_NAME=""

# --- Powiadomienia e-mail -------------------------------------------------
# console = tryb demo (treść maila w logach serwera), smtp = prawdziwa wysyłka.
MAIL_MODE="console"
RESTAURANT_EMAIL="kuchnia@trattoria-sole.example"
MAIL_FROM="Trattoria Sole <zamowienia@trattoria-sole.example>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
